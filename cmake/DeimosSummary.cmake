include_guard(GLOBAL)

function(deimos_report_option name)
    if(${name})
        message(STATUS "  ${name}: ON")
    else()
        message(STATUS "  ${name}: OFF")
    endif()
endfunction()

message(STATUS "")
message(STATUS "Deimos ${PROJECT_VERSION} (${CMAKE_SYSTEM_NAME}, ${CMAKE_CXX_COMPILER_ID})")
deimos_report_option(DEIMOS_BUILD_DAEMON)
deimos_report_option(DEIMOS_BUILD_CLI)
deimos_report_option(DEIMOS_BUILD_UI)
deimos_report_option(DEIMOS_BUILD_TESTS)
deimos_report_option(DEIMOS_ENABLE_TLS)
deimos_report_option(DEIMOS_STATIC_RUNTIME)
deimos_report_option(DEIMOS_FETCH_DEPS)
message(STATUS "")
